# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 虚拟环境 ----
.venv/
venv/

# ---- Node ----
node_modules/

# ---- 运行时产物 ----
*.log
video_processing_metadata.json
.redistribute_log.json
*.part1.*
*.part2.*
title_compare/

# ---- 本地 AI 工具配置，默认不入库 ----
# 只放行一个产线 skill：batch-video-renamer
# 注意：要放行子目录，必须逐级放行父目录，否则规则不生效
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/batch-video-renamer/
# 片单生成脚本：`conf/本机.yaml` 的 paths.excel_generator 指向它，
# 是台账环节的运行依赖 —— 必须入库，否则换台机器 git clone 完就跑不了 ledger。
!.claude/skills/excel-sheet-generator/

# ---- 含明文凭证，不入库（百度/夸克 MCP 配置）----
.mcp.json

# ---- 本机环境 / 账号（每台机器、每个账号不同）----
conf/本机.yaml
conf/本机能力.yaml
# agent.yaml 含 DeepSeek 明文 key，且模型名会跟着厂商变 —— 单独一个文件，
# 换账号/换模型只改它，不动路径配置。模板是 conf/agent.example.yaml（入库）。
conf/agent.yaml

# ---- 旧模块自动生成的数据目录 ----
# 这三个目录曾经被 git 跟踪（或曾经被误当成日志位置），是"用户数据/运行产物
# 进代码仓库"的典型：
#   titles/          → 批次产出（标题），应写到工作区 {批次}/标题.md
#   knowledge_base/  → 游戏级字典库，已迁到 conf/知识库/ 并入库
#   logs/（两级）    → 旧 logger 的默认 log_dir，在仓库里；真正的日志在
#                      工作区 {批次}/log/。保留忽略规则，防止再长出来。
src/deal_video_agent/titles/
src/deal_video_agent/knowledge_base/
src/logs/
/logs/

# ---- 研究记录，不入库 ----
# research/ 放的是我们自己研究、探测、诊断的产物：
#   剪映 GUI 自动化的实测结论、流水线诊断、被推翻的假设、复现脚本……
# 这些是"开发时怎么想明白的"，不是"用户怎么用"。
# 给用户看的说明在 docs/（入库），两者的分工见 AGENTS.md。
#
# 代价：research/ 不进 git，换机器或 git clean 就没了。需要长期留存的内容
# 应提炼成 docs/ 里的一句话或 conf/ 里的一条规则。
research/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
Thumbs.db
desktop.ini

# ---- 打包备份 ----
*.zip
